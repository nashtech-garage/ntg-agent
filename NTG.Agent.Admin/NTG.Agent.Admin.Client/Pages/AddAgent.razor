@page "/agents/new"
@page "/agents/duplicate/{sourceAgentId:guid}"
@attribute [Authorize]
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@using NTG.Agent.Common.Dtos.Agents
@using NTG.Agent.Admin.Client.Components
@inject AgentClient AgentClient
@inject FolderClient FolderClient
@inject NavigationManager Navigation
@inject ILogger<AddAgent> Logger

<PageTitle>@(isDuplicating ? "Duplicate Agent" : "Create New Agent")</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Agents</a></li>
                    @if (isDuplicating && !string.IsNullOrEmpty(sourceAgentName))
                    {
                        <li class="breadcrumb-item"><a href="/agents/@SourceAgentId" class="text-decoration-none">@sourceAgentName</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Duplicate Agent</li>
                    }
                    else
                    {
                        <li class="breadcrumb-item active" aria-current="page">@(isInner ? "Create Inner Agent" : "Create New Agent")</li>
                    }
                </ol>
            </nav>
            
            <div class="d-flex align-items-center mb-3">
                <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center me-3" 
                     style="width: 40px; height: 40px;">
                    <i class="bi @(isDuplicating ? "bi-copy" : "bi-plus-circle") text-white" style="font-size: 1.2rem;"></i>
                </div>
                <div>
                    <h1 class="h3 mb-0">@(isDuplicating ? "Duplicate Agent" : (isInner ? "Create Inner Agent" : "Create New Agent"))</h1>
                    @if (isDuplicating && !string.IsNullOrEmpty(sourceAgentName))
                    {
                        <small class="text-muted">Creating a copy of "@sourceAgentName"</small>
                    }
                    else if (isInner)
                    {
                        <small class="text-muted">Define a focused agent that can be called as a tool by other agents.</small>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="row">
            <div class="col-12">
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
                </div>
            </div>
        </div>
    }

    @if (isLoadingSource)
    {
        <div class="row">
            <div class="col-12">
                <div class="d-flex justify-content-center align-items-center" style="min-height: 200px;">
                    <div class="text-center">
                        <div class="spinner-border text-primary mb-3" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="text-muted">Loading agent details...</p>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12 col-lg-10 col-xl-8">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <EditForm Model="@agentDetail" OnValidSubmit="HandleValidSubmit">
                        <DataAnnotationsValidator />
                         
                            <div class="mb-4">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-diagram-3 me-2 text-primary"></i>
                                    Agent Kind <span class="text-danger">*</span>
                                </label>
                                <div class="form-text mb-2">Choose whether this agent faces users directly or serves as a tool for other agents.</div>
                                <div class="d-flex gap-4">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="agentKind" id="kindOuter"
                                               checked="@(agentDetail.AgentKind == AgentKind.Outer)"
                                               @onchange="() => { agentDetail.AgentKind = AgentKind.Outer; }"
                                               disabled="@isSubmitting" />
                                        <label class="form-check-label" for="kindOuter">
                                            <i class="bi bi-people-fill text-primary me-1"></i><strong>Outer Agent</strong>
                                            <div class="text-muted small">User-facing agent that conversations are routed to.</div>
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="agentKind" id="kindInner"
                                               checked="@(agentDetail.AgentKind == AgentKind.Inner)"
                                               @onchange="SelectInnerKind"
                                               disabled="@isSubmitting" />
                                        <label class="form-check-label" for="kindInner">
                                            <i class="bi bi-tools text-success me-1"></i><strong>Inner Agent</strong>
                                            <div class="text-muted small">Specialized sub-agent callable as a tool by outer agents.</div>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <hr class="my-4" />

                            @* Knowledge base. Outer agents only: an inner agent has no knowledge
                               base at all, so the whole section is withheld rather than disabled. *@
                            <div class="mb-4">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-journals me-2 text-primary"></i>
                                    Knowledge Base
                                </label>
                                @if (isInner)
                                {
                                    <div class="form-text">
                                        Inner agents answer from their instructions and tools. They have no knowledge base.
                                    </div>
                                }
                                else
                                {
                                    <div class="form-text mb-2">
                                        Where this agent's documents live. A knowledge base can be shared by several agents.
                                    </div>
                                    <div class="d-flex gap-4 mb-2">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="knowledgeBase" id="kbNew"
                                                   checked="@(agentDetail.KnowledgeOwnerAgentId is null)"
                                                   @onchange="() => agentDetail.KnowledgeOwnerAgentId = null"
                                                   disabled="@isSubmitting" />
                                            <label class="form-check-label" for="kbNew">
                                                <i class="bi bi-plus-square text-primary me-1"></i><strong>Create a new knowledge base</strong>
                                                <div class="text-muted small">This agent gets its own documents, private to it.</div>
                                            </label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="knowledgeBase" id="kbJoin"
                                                   checked="@(agentDetail.KnowledgeOwnerAgentId is not null)"
                                                   @onchange="SelectFirstKnowledgeBase"
                                                   disabled="@(isSubmitting || knowledgeBases.Count == 0)" />
                                            <label class="form-check-label" for="kbJoin">
                                                <i class="bi bi-people text-success me-1"></i><strong>Join an existing knowledge base</strong>
                                                <div class="text-muted small">
                                                    @(knowledgeBases.Count == 0
                                                        ? "No knowledge bases available to join yet."
                                                        : "Share documents with the agents already in it.")
                                                </div>
                                            </label>
                                        </div>
                                    </div>

                                    @if (agentDetail.KnowledgeOwnerAgentId is not null)
                                    {
                                        <select class="form-select mb-2"
                                                value="@agentDetail.KnowledgeOwnerAgentId"
                                                @onchange="OnKnowledgeBaseChanged"
                                                disabled="@isSubmitting">
                                            @foreach (var kb in knowledgeBases)
                                            {
                                                <option value="@kb.OwnerAgentId">
                                                    @kb.OwnerAgentName — @kb.AgentCount agent@(kb.AgentCount == 1 ? "" : "s"), @kb.DocumentCount document@(kb.DocumentCount == 1 ? "" : "s")
                                                </option>
                                            }
                                        </select>
                                        <div class="alert alert-warning py-2 mb-0" role="alert">
                                            <i class="bi bi-exclamation-triangle me-1"></i>
                                            <strong>Agents in a knowledge base share every document in it.</strong>
                                            This agent will be able to read all documents already in the knowledge base,
                                            and anything uploaded through it becomes readable by the other agents there.
                                        </div>
                                    }
                                }
                            </div>

                            <hr class="my-4" />

                        <div class="mb-4">
                            <label for="name" class="form-label fw-semibold">
                                <i class="bi bi-robot me-2 text-primary"></i>
                                Agent Name <span class="text-danger">*</span>
                            </label>
                            <InputText id="name" class="form-control form-control-lg" @bind-Value="agentDetail.Name" 
                                       placeholder="Enter agent name" disabled="@isSubmitting" />
                            <ValidationMessage For="@(() => agentDetail.Name)" class="text-danger small mt-1" />
                        </div>

                        <div class="mb-4">
                            <label for="description" class="form-label fw-semibold">
                                <i class="bi bi-info-square me-2 text-primary"></i>
                                Description <span class="text-muted">(Optional)</span>
                            </label>
                            <InputTextArea id="description" class="form-control" rows="3" @bind-Value="agentDetail.Description" 
                                           placeholder="Enter a brief description of the agent..." disabled="@isSubmitting" />
                            <ValidationMessage For="@(() => agentDetail.Description)" class="text-danger small mt-1" />
                            <div class="form-text">
                                <i class="bi bi-info-circle me-1"></i>
                                A short description to help identify the purpose of this agent.
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="instructions" class="form-label fw-semibold">
                                <i class="bi bi-card-text me-2 text-primary"></i>
                                @(isInner ? "System Prompt / Role" : "Instructions") <span class="text-muted">(Optional)</span>
                            </label>
                            <InputTextArea id="instructions" class="form-control" rows="6" @bind-Value="agentDetail.Instructions" 
                                           placeholder="Enter detailed instructions for the agent..." disabled="@isSubmitting" />
                            <div class="form-text">
                                <i class="bi bi-info-circle me-1"></i>
                                Provide clear instructions on how the agent should behave and respond.
                            </div>
                        </div>

                        <hr class="my-4" />

                        <h5 class="mb-3">
                            <i class="bi bi-gear-fill me-2 text-primary"></i>
                            LLM Provider Configuration
                        </h5>

                        <ProviderModelSelector @bind-ProviderId="agentDetail.ProviderId" @bind-ModelOverride="agentDetail.ModelOverride" IsInner="@isInner" SupportsThinkingChanged="OnSupportsThinkingChanged" />

                        <div class="mb-4">
                            <label for="mcpServer" class="form-label fw-semibold">
                                MCP Server <span class="text-muted">(Optional)</span>
                            </label>
                            <InputText id="mcpServer" class="form-control" @bind-Value="agentDetail.McpServer" 
                                       placeholder="Enter MCP server endpoint (optional)" disabled="@isSubmitting" />
                            <div class="form-text">
                                <i class="bi bi-info-circle me-1"></i>
                                Model Context Protocol server endpoint for additional capabilities.
                            </div>
                        </div>

                        @if (!isInner)
                        {
                            <div class="mb-4">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-lightning-charge me-2 text-primary"></i>
                                    Agent Mode
                                </label>
                                <div class="form-text mb-2">Controls how the agent generates responses.</div>
                                <div class="d-flex gap-4">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="agentMode" id="modeFast"
                                               checked="@(agentDetail.Mode == AgentMode.Fast)"
                                               @onchange="() => agentDetail.Mode = AgentMode.Fast"
                                               disabled="@isSubmitting" />
                                        <label class="form-check-label" for="modeFast">
                                            <i class="bi bi-lightning-charge-fill text-warning me-1"></i><strong>Fast</strong>
                                            <div class="text-muted small">Returns the final answer immediately.</div>
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="agentMode" id="modeThinking"
                                               checked="@(agentDetail.Mode == AgentMode.Thinking)"
                                               @onchange="() => agentDetail.Mode = AgentMode.Thinking"
                                               disabled="@(isSubmitting || !supportsThinking)" />
                                        <label class="form-check-label" for="modeThinking">
                                            <i class="bi bi-cpu-fill text-info me-1"></i><strong>Thinking</strong>
                                            <div class="text-muted small">Shows reasoning steps before the answer.</div>
                                        </label>
                                    </div>
                                </div>
                                @if (!supportsThinking)
                                {
                                    <div class="text-muted small mt-1">Not supported by this model.</div>
                                }
                            </div>
                        }

                        <hr class="my-4" />

                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-outline-secondary" @onclick="NavigateBack" disabled="@isSubmitting">
                                <i class="bi bi-x-circle me-2"></i>
                                Cancel
                            </button>
                            <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Creating...</span>
                                }
                                else
                                {
                                    <i class="bi bi-check-circle me-2"></i>
                                    <span>@(isInner ? "Create Inner Agent" : "Create Agent")</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid? SourceAgentId { get; set; }

    private AgentDetail agentDetail = new AgentDetail();
    private bool isSubmitting = false;
    private bool isLoadingSource = false;
    private string? errorMessage;
    private bool isDuplicating => SourceAgentId.HasValue;
    private bool isInner => agentDetail.AgentKind == AgentKind.Inner;
    private string sourceAgentName = string.Empty;
    private bool supportsThinking;
    private IList<KnowledgeBaseListItem> knowledgeBases = [];

    // Switching to Inner clears any knowledge base picked while Outer was selected — an inner
    // agent has none, and the server rejects a create that asks for one.
    private void SelectInnerKind()
    {
        agentDetail.AgentKind = AgentKind.Inner;
        agentDetail.Mode = AgentMode.Fast;
        agentDetail.KnowledgeOwnerAgentId = null;
    }

    private void SelectFirstKnowledgeBase()
    {
        if (knowledgeBases.Count > 0)
        {
            agentDetail.KnowledgeOwnerAgentId = knowledgeBases[0].OwnerAgentId;
        }
    }

    private void OnKnowledgeBaseChanged(ChangeEventArgs e)
    {
        agentDetail.KnowledgeOwnerAgentId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
    }

    private Task OnSupportsThinkingChanged(bool supported)
    {
        supportsThinking = supported;
        if (!supported && agentDetail.Mode == AgentMode.Thinking)
        {
            agentDetail.Mode = AgentMode.Fast;
        }
        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        // Best-effort: the picker is an enhancement, so a failure here must not block agent
        // creation. An empty list simply disables "join an existing knowledge base".
        try
        {
            knowledgeBases = await AgentClient.GetKnowledgeBasesAsync();
        }
        catch (Exception)
        {
            knowledgeBases = [];
        }

        if (SourceAgentId.HasValue)
        {
            await LoadSourceAgent(SourceAgentId.Value);
        }
    }

    private async Task LoadSourceAgent(Guid sourceId)
    {
        try
        {
            isLoadingSource = true;
            var sourceAgent = await AgentClient.GetAgentDetails(sourceId);
            
            if (sourceAgent != null)
            {
                agentDetail = new AgentDetail
                {
                    Name = $"{sourceAgent.Name} (Copy)",
                    Description = sourceAgent.Description,
                    Instructions = sourceAgent.Instructions,
                    ProviderId = sourceAgent.ProviderId,
                    ModelOverride = sourceAgent.ModelOverride,
                    McpServer = sourceAgent.McpServer,
                    Mode = sourceAgent.Mode,
                    AgentKind = sourceAgent.AgentKind
                };
                sourceAgentName = sourceAgent.Name;
            }
            else
            {
                errorMessage = "Source agent not found.";
                Logger.LogWarning("Source agent with ID {SourceId} not found", sourceId);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load source agent: {ex.Message}";
            Logger.LogError(ex, "Error loading source agent with ID {SourceId}", sourceId);
        }
        finally
        {
            isLoadingSource = false;
        }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            isSubmitting = true;
            errorMessage = null;

            var newAgentId = await AgentClient.CreateAgent(agentDetail);

            if (newAgentId != Guid.Empty)
            {
                try
                {
                    await FolderClient.CreateDefaultFoldersForAgent(newAgentId);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Failed to create default folder for agent {AgentId}", newAgentId);
                }
            }

            if (agentDetail.AgentKind == AgentKind.Inner)
            {
                Navigation.NavigateTo($"/agents/{newAgentId}");
            }
            else
            {
                Navigation.NavigateTo("/");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to create agent: {ex.Message}";
            Logger.LogError(ex, "Error creating agent");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo("/");
    }
}
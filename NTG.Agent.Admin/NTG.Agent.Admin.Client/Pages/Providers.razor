@page "/providers"
@attribute [Authorize]
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@using NTG.Agent.Common.Dtos.Agents
@inject AgentClient AgentClient

<PageTitle>Providers</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">
            <i class="bi bi-cloud-fill me-2"></i>Providers
        </h1>
        <button class="btn btn-primary" @onclick="ShowCreateModal">
            <i class="bi bi-plus-circle me-2"></i>Add Provider
        </button>
    </div>

    @if (providers == null)
    {
        <div class="d-flex justify-content-center"><div class="spinner-border text-primary"></div></div>
    }
    else if (providers.Count == 0)
    {
        <div class="alert alert-info">No providers configured. Add one to get started.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Endpoint</th>
                        <th>API Key</th>
                        <th>Models</th>
                        <th>Agents</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in providers)
                    {
                        <tr>
                            <td><strong>@p.Name</strong></td>
                            <td><span class="badge bg-primary">@p.ProviderType.ToDisplayName()</span></td>
                            <td><small class="text-muted">@(p.Endpoint ?? "—")</small></td>
                            <td>
                                @if (p.HasApiKey)
                                {
                                    <span class="badge bg-success-subtle text-success">configured</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td><span class="badge bg-secondary">@p.Models.Count</span></td>
                            <td><span class="badge bg-secondary">@p.AgentCount</span></td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => ShowEditModal(p.Id)" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ShowDeleteModal(p)" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (showFormModal && editingProvider != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editingProvider.Id != Guid.Empty ? "Edit Provider" : "Create Provider")</h5>
                    <button type="button" class="btn-close" @onclick="CloseFormModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" @bind="editingProvider.Name" placeholder="e.g., My OpenAI" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Provider Type <span class="text-danger">*</span></label>
                        <select class="form-select" value="@editingProvider.ProviderType" @onchange="OnProviderTypeChanged">
                            @foreach (ProviderType t in Enum.GetValues<ProviderType>())
                            {
                                <option value="@t">@t.ToDisplayName()</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Endpoint</label>
                        <input type="text" class="form-control" @bind="editingProvider.Endpoint"
                               placeholder="@GetEndpointPlaceholder(editingProvider.ProviderType)"
                               readonly="@IsEndpointReadonly(editingProvider.ProviderType)" />
                    </div>
                    @if (editingProvider.ProviderType == ProviderType.AzureOpenAI)
                    {
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">AI Services Account Name</label>
                                <input type="text" class="form-control" @bind="editingProvider.AzureAiAccountName"
                                       placeholder="e.g., rmit-capstone-2026-hcm--resource" />
                                <div class="form-text">Used to list this project's deployments (not the full model catalog).</div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">AI Foundry Project Name</label>
                                <input type="text" class="form-control" @bind="editingProvider.AzureAiProjectName"
                                       placeholder="e.g., rmit-capstone-2026-hcm-eastus2" />
                            </div>
                        </div>
                    }
                    <div class="mb-3">
                        <label class="form-label">API Key</label>
                        <div class="input-group">
                            <input type="@(showKey ? "text" : "password")" class="form-control" @bind="editingProvider.ApiKey"
                                   placeholder="@(editingProvider.HasApiKey ? "Leave blank to keep the current key" : "Enter API key")" />
                            <button class="btn btn-outline-secondary" type="button" @onclick="() => showKey = !showKey">
                                <i class="bi @(showKey ? "bi-eye-slash" : "bi-eye")"></i>
                            </button>
                        </div>
                        <div class="form-text">The stored key is never shown; enter a new one only to replace it.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Models available to agents</label>
                        @if (editingProvider.ProviderType == ProviderType.Custom)
                        {
                            <div class="form-text mb-2">Custom providers expose no model catalog — add each model manually.</div>
                            <div class="table-responsive">
                                <table class="table table-sm align-middle">
                                    <thead>
                                        <tr>
                                            <th style="width:45%;">Model ID</th>
                                            <th style="width:30%;">Thinking mode</th>
                                            <th style="width:10%;"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var m in editingProvider.Models)
                                        {
                                            <tr>
                                                <td><input type="text" class="form-control form-control-sm" @bind="m.ModelId" placeholder="e.g., my-model-v1" /></td>
                                                <td>
                                                    <div class="form-check form-switch mb-0">
                                                        <input class="form-check-input" type="checkbox" role="switch" id="@("think-" + editingProvider.Models.IndexOf(m))"
                                                               checked="@m.AllowsThinking" @onchange="() => m.AllowsThinking = !m.AllowsThinking" />
                                                        <label class="form-check-label small" for="@("think-" + editingProvider.Models.IndexOf(m))">Allow</label>
                                                    </div>
                                                </td>
                                                <td>
                                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => editingProvider.Models.Remove(m)" title="Remove">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                        @if (editingProvider.Models.Count == 0)
                                        {
                                            <tr><td colspan="3" class="text-muted small">No models yet — click "Add Model" below.</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddCustomModel">
                                <i class="bi bi-plus-circle me-1"></i>Add Model
                            </button>
                        }
                        else
                        {
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="FetchModels" disabled="@isFetching">
                                    @if (isFetching)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                    }
                                    <i class="bi bi-cloud-download"></i> Fetch Models
                                </button>
                                <small class="text-muted">Fetches the provider's available models; tick the ones agents may use.</small>
                            </div>
                            @if (fetchMessage != null)
                            {
                                <div class="alert @(fetchSucceeded ? "alert-success" : "alert-danger") py-2 small">@fetchMessage</div>
                            }
                            @if (modelChoices != null && modelChoices.Count > 0)
                            {
                                <div class="table-responsive" style="max-height: 280px; overflow-y: auto;">
                                    <table class="table table-sm align-middle mb-0">
                                        <thead>
                                            <tr>
                                                <th style="width:10%;">Enable</th>
                                                <th style="width:45%;">Model</th>
                                                <th style="width:35%;">Thinking mode</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var c in modelChoices)
                                            {
                                                <tr class="@(c.IsEnabled ? "" : "opacity-50")">
                                                    <td>
                                                        <input class="form-check-input" type="checkbox" checked="@c.IsEnabled"
                                                               @onchange="() => ToggleModelEnabled(c)" />
                                                    </td>
                                                    <td>
                                                        <span class="fw-semibold">@c.ModelId</span>
                                                        @if (!string.IsNullOrEmpty(c.DisplayName))
                                                        {
                                                            <div class="text-muted small">@c.DisplayName</div>
                                                        }
                                                    </td>
                                                    <td>
                                                        <div class="form-check form-switch mb-0">
                                                            <input class="form-check-input" type="checkbox" role="switch"
                                                                   checked="@c.AllowsThinking"
                                                                   disabled="@(!c.IsEnabled || !c.SupportsThinking)"
                                                                   @onchange="() => ToggleThinking(c)"
                                                                   title="@(c.SupportsThinking ? "Allow agents to use Thinking mode with this model" : "This model does not support Thinking mode")" />
                                                            <label class="form-check-label small">
                                                                @if (!c.SupportsThinking) { <span class="text-muted">Not thinking-capable</span> }
                                                                else if (c.AllowsThinking) { <span>Allowed</span> }
                                                                else { <span>Off</span> }
                                                            </label>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-muted small">No models loaded yet. Save the provider and click "Fetch Models".</div>
                            }
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(formError))
                    {
                        <div class="alert alert-danger">@formError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseFormModal">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveProvider" disabled="@isSaving">
                        @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showDeleteModal && deletingProvider != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-danger">Delete Provider</h5>
                    <button type="button" class="btn-close" @onclick="() => { showDeleteModal = false; deletingProvider = null; }"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete <strong>@deletingProvider.Name</strong>?</p>
                    @if (deletingProvider.AgentCount > 0)
                    {
                        <div class="alert alert-warning">This provider is used by @deletingProvider.AgentCount agent(s). It cannot be deleted until all agents are reassigned.</div>
                    }
                    <p class="text-muted">This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => { showDeleteModal = false; deletingProvider = null; }">Cancel</button>
                    <button class="btn btn-danger" @onclick="DeleteProvider" disabled="@(deletingProvider.AgentCount > 0)">
                        Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private IList<ProviderDto>? providers;
    private ProviderDto? editingProvider;
    private ProviderDto? deletingProvider;
    private bool showFormModal;
    private bool showDeleteModal;
    private bool showKey;
    private bool isSaving;
    private bool isFetching;
    private string? formError;
    private string? fetchMessage;
    private bool fetchSucceeded;

    private IList<ModelItem>? discoveredModels;
    private List<ModelChoice>? modelChoices;

    private sealed class ModelChoice
    {
        public string ModelId { get; set; } = string.Empty;
        public string? DisplayName { get; set; }
        public bool IsEnabled { get; set; }
        public bool AllowsThinking { get; set; }
        public bool SupportsThinking { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadProviders();
    }

    private async Task LoadProviders()
    {
        providers = await AgentClient.GetProvidersAsync();
    }

    private void ShowCreateModal()
    {
        editingProvider = new ProviderDto { ProviderType = ProviderType.OpenAI };
        ResetModalState();
        showFormModal = true;
    }

    private async Task ShowEditModal(Guid id)
    {
        editingProvider = await AgentClient.GetProviderAsync(id);
        ResetModalState();
        if (editingProvider != null)
        {
            RebuildModelChoices();
        }
        showFormModal = true;
    }

    private void ResetModalState()
    {
        formError = null;
        fetchMessage = null;
        fetchSucceeded = false;
        discoveredModels = null;
        modelChoices = null;
    }

    private void ShowDeleteModal(ProviderDto p)
    {
        deletingProvider = p;
        showDeleteModal = true;
    }

    private void CloseFormModal()
    {
        showFormModal = false;
        editingProvider = null;
        ResetModalState();
    }

    private async Task SaveProvider()
    {
        if (editingProvider == null) return;
        if (string.IsNullOrWhiteSpace(editingProvider.Name)) { formError = "Name is required."; return; }
        isSaving = true; formError = null;
        try
        {
            if (editingProvider.Id == Guid.Empty)
                await AgentClient.CreateProviderAsync(editingProvider);
            else
                await AgentClient.UpdateProviderAsync(editingProvider);
            CloseFormModal();
            await LoadProviders();
        }
        catch (Exception ex) { formError = ex.Message; }
        finally { isSaving = false; }
    }

    private async Task DeleteProvider()
    {
        if (deletingProvider == null) return;
        try
        {
            await AgentClient.DeleteProviderAsync(deletingProvider.Id);
            showDeleteModal = false;
            deletingProvider = null;
            await LoadProviders();
        }
        catch (Exception) { /* handled by UI disabled state */ }
    }

    private async Task FetchModels()
    {
        if (editingProvider == null) return;
        isFetching = true; fetchMessage = null; discoveredModels = null; modelChoices = null;
        try
        {
            // Save first so the discovery endpoint can read the stored credentials.
            if (editingProvider.Id == Guid.Empty)
            {
                var id = await AgentClient.CreateProviderAsync(editingProvider);
                editingProvider.Id = id;
            }
            else
            {
                await AgentClient.UpdateProviderAsync(editingProvider);
            }
            discoveredModels = await AgentClient.GetProviderModelsAsync(editingProvider.Id);
            RebuildModelChoices();
            fetchSucceeded = true;
            fetchMessage = $"Found {discoveredModels.Count} model(s). Tick the ones agents may use.";
        }
        catch (Exception ex)
        {
            fetchSucceeded = false;
            fetchMessage = ex.Message;
        }
        finally { isFetching = false; }
    }

    /// <summary>
    /// Merges the discovered models with the admin's persisted choices. Discovered models get the
    /// backend's thinking-capability verdict (used to grey out the toggle); persisted models the
    /// provider no longer reports stay editable so admins can clean them up.
    /// </summary>
    private void RebuildModelChoices()
    {
        if (editingProvider == null) { modelChoices = null; return; }
        if (editingProvider.ProviderType == ProviderType.Custom) { modelChoices = null; return; }

        var choices = new List<ModelChoice>();
        var persistedById = editingProvider.Models
            .GroupBy(m => m.ModelId, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

        if (discoveredModels != null)
        {
            var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var dm in discoveredModels)
            {
                persistedById.TryGetValue(dm.Id, out var pm);
                choices.Add(new ModelChoice
                {
                    ModelId = dm.Id,
                    DisplayName = dm.DisplayName,
                    IsEnabled = pm != null,
                    AllowsThinking = pm?.AllowsThinking ?? false,
                    SupportsThinking = dm.SupportsThinking
                });
                seen.Add(dm.Id);
            }
            foreach (var m in editingProvider.Models)
            {
                if (seen.Contains(m.ModelId)) continue;
                choices.Add(new ModelChoice
                {
                    ModelId = m.ModelId,
                    DisplayName = m.DisplayName,
                    IsEnabled = true,
                    AllowsThinking = m.AllowsThinking,
                    SupportsThinking = true
                });
            }
        }
        else
        {
            foreach (var m in editingProvider.Models)
            {
                choices.Add(new ModelChoice
                {
                    ModelId = m.ModelId,
                    DisplayName = m.DisplayName,
                    IsEnabled = true,
                    AllowsThinking = m.AllowsThinking,
                    SupportsThinking = true
                });
            }
        }
        modelChoices = choices;
    }

    private void ToggleModelEnabled(ModelChoice c)
    {
        if (editingProvider == null) return;
        c.IsEnabled = !c.IsEnabled;
        var existing = editingProvider.Models
            .FirstOrDefault(m => string.Equals(m.ModelId, c.ModelId, StringComparison.OrdinalIgnoreCase));
        if (c.IsEnabled)
        {
            if (existing == null)
            {
                editingProvider.Models.Add(new ProviderModelDto
                {
                    ModelId = c.ModelId,
                    DisplayName = c.DisplayName,
                    AllowsThinking = c.AllowsThinking
                });
            }
        }
        else
        {
            if (existing != null) editingProvider.Models.Remove(existing);
            c.AllowsThinking = false;
        }
    }

    private void ToggleThinking(ModelChoice c)
    {
        if (editingProvider == null || !c.SupportsThinking) return;
        c.AllowsThinking = !c.AllowsThinking;
        var existing = editingProvider.Models
            .FirstOrDefault(m => string.Equals(m.ModelId, c.ModelId, StringComparison.OrdinalIgnoreCase));
        if (existing != null) existing.AllowsThinking = c.AllowsThinking;
    }

    private void AddCustomModel()
    {
        editingProvider!.Models.Add(new ProviderModelDto());
    }

    private void OnProviderTypeChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<ProviderType>(e.Value?.ToString(), out var type))
        {
            editingProvider!.ProviderType = type;
            editingProvider!.Endpoint = type switch
            {
                ProviderType.OpenAI => "https://api.openai.com/v1",
                ProviderType.Anthropic => "https://api.anthropic.com/v1",
                ProviderType.GoogleGemini => "https://generativelanguage.googleapis.com/v1beta",
                _ => editingProvider.Endpoint
            };
            fetchMessage = null;
            discoveredModels = null;
            RebuildModelChoices();
        }
    }

    private static string GetEndpointPlaceholder(ProviderType type) => type switch
    {
        ProviderType.OpenAI => "https://api.openai.com/v1",
        ProviderType.AzureOpenAI => "https://{resource}.openai.azure.com",
        ProviderType.Anthropic => "https://api.anthropic.com/v1",
        ProviderType.GoogleGemini => "https://generativelanguage.googleapis.com/v1beta",
        ProviderType.OpenAICompatible => "https://your-endpoint/v1",
        ProviderType.Custom => "https://your-endpoint/v1 (optional)",
        _ => ""
    };

    private static bool IsEndpointReadonly(ProviderType type) => type is ProviderType.OpenAI or ProviderType.Anthropic;
}

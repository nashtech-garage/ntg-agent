# Copy to `.env` on the Ubuntu server and fill in.

# Password for the Postgres `postgres` superuser. MUST match the Orchestrator's
# LightRag__PostgresPassword (the AppHost `lightrag-pg-password` parameter).
POSTGRES_PASSWORD=

# Directory holding the staged server-cert.pem / server-key.pem that Postgres serves
# TLS with. The files must be owned by uid 999 and the key must be mode 600 — see the
# header of docker-compose.yml for the commands that stage them.
PG_CERT_DIR=/home/ntgagent/docker-certs/pg

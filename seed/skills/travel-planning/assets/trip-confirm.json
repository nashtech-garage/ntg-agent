{
  "surfaceId": "trip-confirm",
  "components": [
    { "id": "root", "component": "Column", "children": ["title", "r-dest", "r-dates", "r-travellers", "r-option", "sep", "r-total", "note", "actions"] },

    { "id": "title", "component": "Text", "text": "Review your trip", "variant": "h4" },

    { "id": "r-dest", "component": "Row", "justify": "spaceBetween", "align": "start", "children": ["l-dest", "v-dest"] },
    { "id": "l-dest", "component": "Text", "text": "Destination", "variant": "caption" },
    { "id": "v-dest", "component": "Text", "text": { "path": "/confirm/destination" }, "variant": "body" },

    { "id": "r-dates", "component": "Row", "justify": "spaceBetween", "align": "start", "children": ["l-dates", "v-dates"] },
    { "id": "l-dates", "component": "Text", "text": "Dates", "variant": "caption" },
    { "id": "v-dates", "component": "Text", "text": { "path": "/confirm/dates" }, "variant": "body" },

    { "id": "r-travellers", "component": "Row", "justify": "spaceBetween", "align": "start", "children": ["l-travellers", "v-travellers"] },
    { "id": "l-travellers", "component": "Text", "text": "Travellers", "variant": "caption" },
    { "id": "v-travellers", "component": "Text", "text": { "path": "/confirm/travellers" }, "variant": "body" },

    { "id": "r-option", "component": "Row", "justify": "spaceBetween", "align": "start", "children": ["l-option", "v-option"] },
    { "id": "l-option", "component": "Text", "text": "Option", "variant": "caption" },
    { "id": "v-option", "component": "Text", "text": { "path": "/confirm/option" }, "variant": "body" },

    { "id": "sep", "component": "Divider", "axis": "horizontal" },

    { "id": "r-total", "component": "Row", "justify": "spaceBetween", "align": "center", "children": ["l-total", "v-total"] },
    { "id": "l-total", "component": "Text", "text": "Total", "variant": "caption" },
    { "id": "v-total", "component": "Text", "text": { "path": "/confirm/total" }, "variant": "h5" },

    { "id": "note", "component": "Text", "text": "Demonstration only — nothing will be booked and no payment is taken.", "variant": "caption" },

    { "id": "actions", "component": "Row", "justify": "spaceBetween", "align": "center", "children": ["change", "confirm"] },

    {
      "id": "change",
      "component": "Button",
      "variant": "default",
      "child": "change-label",
      "action": { "event": { "name": "trip_change_requested", "context": {} } }
    },
    { "id": "change-label", "component": "Text", "text": "Change details" },

    {
      "id": "confirm",
      "component": "Button",
      "variant": "primary",
      "child": "confirm-label",
      "action": {
        "event": {
          "name": "trip_booking_confirmed",
          "context": {
            "destination": { "path": "/confirm/destination" },
            "dates": { "path": "/confirm/dates" },
            "option": { "path": "/confirm/option" },
            "total": { "path": "/confirm/total" }
          }
        }
      }
    },
    { "id": "confirm-label", "component": "Text", "text": "Confirm plan" }
  ],
  "data": {
    "confirm": {
      "destination": "",
      "dates": "",
      "travellers": "",
      "option": "",
      "total": ""
    }
  }
}

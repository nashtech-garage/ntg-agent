{
  "surfaceId": "trip-results",
  "components": [
    { "id": "root", "component": "Column", "children": ["heading", "subheading", "o1-row", "sep-1", "o2-row", "sep-2", "o3-row", "sep-3", "picker", "submit"] },

    { "id": "heading", "component": "Text", "text": { "path": "/results/heading" }, "variant": "h4" },
    { "id": "subheading", "component": "Text", "text": { "path": "/results/subheading" }, "variant": "caption" },

    { "id": "o1-row", "component": "Row", "justify": "spaceBetween", "align": "center", "children": ["o1-info", "o1-price"] },
    { "id": "o1-info", "component": "Column", "children": ["o1-name", "o1-detail"] },
    { "id": "o1-name", "component": "Text", "text": { "path": "/results/o1/name" }, "variant": "body" },
    { "id": "o1-detail", "component": "Text", "text": { "path": "/results/o1/detail" }, "variant": "caption" },
    { "id": "o1-price", "component": "Text", "text": { "path": "/results/o1/price" }, "variant": "h5" },
    { "id": "sep-1", "component": "Divider", "axis": "horizontal" },

    { "id": "o2-row", "component": "Row", "justify": "spaceBetween", "align": "center", "children": ["o2-info", "o2-price"] },
    { "id": "o2-info", "component": "Column", "children": ["o2-name", "o2-detail"] },
    { "id": "o2-name", "component": "Text", "text": { "path": "/results/o2/name" }, "variant": "body" },
    { "id": "o2-detail", "component": "Text", "text": { "path": "/results/o2/detail" }, "variant": "caption" },
    { "id": "o2-price", "component": "Text", "text": { "path": "/results/o2/price" }, "variant": "h5" },
    { "id": "sep-2", "component": "Divider", "axis": "horizontal" },

    { "id": "o3-row", "component": "Row", "justify": "spaceBetween", "align": "center", "children": ["o3-info", "o3-price"] },
    { "id": "o3-info", "component": "Column", "children": ["o3-name", "o3-detail"] },
    { "id": "o3-name", "component": "Text", "text": { "path": "/results/o3/name" }, "variant": "body" },
    { "id": "o3-detail", "component": "Text", "text": { "path": "/results/o3/detail" }, "variant": "caption" },
    { "id": "o3-price", "component": "Text", "text": { "path": "/results/o3/price" }, "variant": "h5" },
    { "id": "sep-3", "component": "Divider", "axis": "horizontal" },

    {
      "id": "picker",
      "component": "ChoicePicker",
      "label": "Which one?",
      "variant": "mutuallyExclusive",
      "value": { "path": "/results/choice" },
      "options": [
        { "label": { "path": "/results/o1/name" }, "value": "o1" },
        { "label": { "path": "/results/o2/name" }, "value": "o2" },
        { "label": { "path": "/results/o3/name" }, "value": "o3" }
      ]
    },

    {
      "id": "submit",
      "component": "Button",
      "variant": "primary",
      "child": "submit-label",
      "action": {
        "event": {
          "name": "trip_option_selected",
          "context": { "choice": { "path": "/results/choice" } }
        }
      }
    },
    { "id": "submit-label", "component": "Text", "text": "Continue to review" }
  ],
  "data": {
    "results": {
      "heading": "Your options",
      "subheading": "",
      "o1": { "name": "Option 1", "detail": "", "price": "" },
      "o2": { "name": "Option 2", "detail": "", "price": "" },
      "o3": { "name": "Option 3", "detail": "", "price": "" },
      "choice": []
    }
  }
}

{
  "surfaceId": "advanced-trip-wizard",
  "components": [
    {
      "id": "root",
      "component": "Column",
      "children": [
        "wizard"
      ]
    },
    {
      "id": "wizard",
      "component": "Tabs",
      "tabs": [
        {
          "title": "1. Trip",
          "child": "trip-pane"
        },
        {
          "title": "2. Options",
          "child": "options-pane"
        },
        {
          "title": "3. Review",
          "child": "review-pane"
        }
      ]
    },
    {
      "id": "trip-pane",
      "component": "Column",
      "children": [
        "trip-title",
        "trip-hint",
        "trip-destination",
        "trip-depart",
        "trip-return",
        "trip-adults",
        "trip-kids",
        "trip-style",
        "trip-submit"
      ]
    },
    {
      "id": "trip-title",
      "component": "Text",
      "text": "Plan your trip",
      "variant": "h4"
    },
    {
      "id": "trip-hint",
      "component": "Text",
      "text": "Tell us the basics and we'll find five stays that fit your style.",
      "variant": "caption"
    },
    {
      "id": "trip-destination",
      "component": "TextField",
      "label": "Where to?",
      "value": {
        "path": "/trip/destination"
      },
      "variant": "shortText"
    },
    {
      "id": "trip-depart",
      "component": "DateTimeInput",
      "label": "Departing",
      "value": {
        "path": "/trip/departDate"
      },
      "enableDate": true,
      "enableTime": false
    },
    {
      "id": "trip-return",
      "component": "DateTimeInput",
      "label": "Returning",
      "value": {
        "path": "/trip/returnDate"
      },
      "enableDate": true,
      "enableTime": false
    },
    {
      "id": "trip-adults",
      "component": "TextField",
      "label": "Adults",
      "value": {
        "path": "/trip/adults"
      },
      "variant": "number"
    },
    {
      "id": "trip-kids",
      "component": "TextField",
      "label": "Kids",
      "value": {
        "path": "/trip/kids"
      },
      "variant": "number"
    },
    {
      "id": "trip-style",
      "component": "ChoicePicker",
      "label": "Trip style",
      "variant": "mutuallyExclusive",
      "value": {
        "path": "/trip/style"
      },
      "options": [
        {
          "label": "Budget — keep it cheap",
          "value": "budget"
        },
        {
          "label": "Balanced — good value",
          "value": "balanced"
        },
        {
          "label": "Comfort — treat myself",
          "value": "comfort"
        }
      ]
    },
    {
      "id": "trip-submit",
      "component": "Button",
      "variant": "primary",
      "child": "trip-submit-label",
      "checks": [
        {
          "condition": {
            "call": "required",
            "args": {
              "value": {
                "path": "/trip/destination"
              }
            },
            "returnType": "boolean"
          },
          "message": "Where to is required."
        },
        {
          "condition": {
            "call": "future_date",
            "args": {
              "value": {
                "path": "/trip/departDate"
              }
            },
            "returnType": "boolean"
          },
          "message": "Departing must be a valid future date."
        },
        {
          "condition": {
            "call": "future_date",
            "args": {
              "value": {
                "path": "/trip/returnDate"
              }
            },
            "returnType": "boolean"
          },
          "message": "Returning must be a valid future date."
        },
        {
          "condition": {
            "call": "date_on_or_after",
            "args": {
              "value": {
                "path": "/trip/returnDate"
              },
              "other": {
                "path": "/trip/departDate"
              }
            },
            "returnType": "boolean"
          },
          "message": "Returning must be on or after Departing."
        },
        {
          "condition": {
            "call": "integer_at_least",
            "args": {
              "value": {
                "path": "/trip/adults"
              },
              "minimum": 1
            },
            "returnType": "boolean"
          },
          "message": "Adults must be a whole number of at least 1."
        },
        {
          "condition": {
            "call": "integer_at_least",
            "args": {
              "value": {
                "path": "/trip/kids"
              },
              "minimum": 0
            },
            "returnType": "boolean"
          },
          "message": "Kids must be a non-negative whole number."
        }
      ],
      "action": {
        "event": {
          "name": "trip_search_submit",
          "context": {
            "destination": {
              "path": "/trip/destination"
            },
            "departDate": {
              "path": "/trip/departDate"
            },
            "returnDate": {
              "path": "/trip/returnDate"
            },
            "adults": {
              "path": "/trip/adults"
            },
            "kids": {
              "path": "/trip/kids"
            },
            "style": {
              "path": "/trip/style"
            },
            "advanceTab": "wizard"
          }
        }
      }
    },
    {
      "id": "trip-submit-label",
      "component": "Text",
      "text": "Find trips"
    },

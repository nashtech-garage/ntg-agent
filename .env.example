# Copy to .env and adjust values for local tooling that reads environment variables
# from a file (optional; .NET Aspire uses user secrets — see README).

# SQL Server SA password (must meet SQL Server complexity rules)
SA_PASSWORD=Admin123_Strong! #gitleaks:allow

# MCP Google Custom Search — required to be non-empty at startup; replace for real search
GOOGLE_API_KEY=placeholder
GOOGLE_SEARCH_ENGINE_ID=placeholder

# LightRAG per-agent RAG containers
LIGHTRAG_PG_PASSWORD=
LIGHTRAG_API_KEY=
# Your Azure OpenAI resource: one endpoint + key serve the LightRAG LLM and embedding
# bindings and the seeded Default Agent. The two names are that resource's deployments.
LIGHTRAG_AZURE_OPENAI_ENDPOINT=
LIGHTRAG_EMBEDDING_API_KEY=
LIGHTRAG_LLM_MODEL=gpt-5.1
LIGHTRAG_EMBEDDING_MODEL=text-embedding-3-large

# Remote LightRAG server, reached over TLS (see deploy/lightrag-postgres/README.md).
# Leave every value below empty for a plain all-local run against the local Docker socket.
LIGHTRAG_DOCKER_HOST=
# Client certificate presented to the daemon, which runs with tlsverify enabled.
LIGHTRAG_DOCKER_CERT_PATH=
LIGHTRAG_DOCKER_CERT_PASSWORD=
# Public address of the server; also the fallback Postgres host.
LIGHTRAG_SERVER_HOST=
# Directory ON THE SERVER holding server-cert.pem / server-key.pem, bind-mounted
# read-only into every agent container so LightRAG can serve HTTPS.
LIGHTRAG_SERVER_CERT_DIR=
# 0.0.0.0 to publish agent containers on all interfaces (remote); empty => 127.0.0.1.
LIGHTRAG_PORT_BIND_HOST_IP=
LIGHTRAG_POSTGRES_PORT=5432
